# Fingertip Finance - variáveis de ambiente
# Qual arquivo vale depende de APP_ENV: dev (padrão) -> .env, demo -> .env.demo,
# prod -> .env.prod. Copie este exemplo para o arquivo do ambiente.

# dev: Postgres local
DATABASE_URL=postgresql://localhost/fingertip_dev

# demo/prod: Neon
# DATABASE_URL=postgresql://user:password@host.neon.tech/fingertip?sslmode=require
